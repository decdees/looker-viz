{
  "data": [
    {
      "id": "concepts",
      "label": "Concepts",
      "elements": [
        {
          "id": "dimension",
          "label": "Dimension (X Axis)",
          "type": "DIMENSION",
          "options": { "min": 1, "max": 1 }
        },
        {
          "id": "barMetric",
          "label": "Bar Metric (left axis)",
          "type": "METRIC",
          "options": { "min": 1, "max": 1 }
        },
        {
          "id": "lineMetric",
          "label": "Line Metric (right axis)",
          "type": "METRIC",
          "options": { "min": 0, "max": 1 }
        }
      ]
    }
  ],
  "style": [
    {
      "id": "seriesStyle",
      "label": "Series",
      "elements": [
        {
          "id": "barColor",
          "label": "Bar Color",
